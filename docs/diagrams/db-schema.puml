@startuml db-schema
title Схема БД

hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0

entity users {
  * **id** : uuid <<PK>>
  --
  * created_at : timestamptz
}

entity orders {
  * **id** : uuid <<PK>>
  --
  * **user_id** : uuid <<FK>>
  * **place_id** : uuid <<FK>>
  * order_status : text
  * total_amount : numeric(12,2)
  locked_by : text
  locked_at : timestamptz
  * created_at : timestamptz
  * updated_at : timestamptz
  ..
  check (total_amount >= 0)
  check (order_status in ('pending', 'accepted', 'rejected', 'completed', 'cancelled', 'expired'))
}

entity order_tracking {
  * **id** : uuid <<PK>>
  --
  * **order_id** : uuid <<FK>>
  * source : text
  * external_code : text
  * status : text
  * occurred_at : timestamptz
  * received_at : timestamptz
  ..
  check (source in ('place', 'delivery'))
  check (status in ('accepted', 'cooking', 'ready', 'handed_over'))
}

entity order_ratings {
  * **id** : uuid <<PK>>
  --
  * **order_id** : uuid <<FK>> <<unique>>
  * **place_id** : uuid <<FK>>
  * **user_id** : uuid <<FK>>
  * score : smallint
  * created_at : timestamptz
  ..
  check (score between 1 and 5)
}

entity places {
  * **id** : uuid <<PK>>
  --
  * name : text
  description : text
  * city : text
  * address : text
  * timezone : text
  * opens_at : time
  * closes_at : time
  * place_type : text
  * webhook_url : text
  * api_key_hash : text
  * is_active : boolean
  * created_at : timestamptz
}

entity place_ratings {
  * **place_id** : uuid <<PK>>
  --
  * rating_sum : bigint
  * rating_count : integer
  ..
  check (rating_sum >= 0)
  check (rating_count >= 0)
}

entity products {
  * **id** : uuid <<PK>>
  --
  * external_id : text
  * **place_id** : uuid <<FK>>
  * name : text
  description : text
  * price : numeric(12,2)
  * stock_quantity : integer
  * is_deleted : boolean
  * created_at : timestamptz
  * updated_at : timestamptz
  ..
  unique (place_id, external_id)
  check (price >= 0)
  check (stock_quantity >= 0)
}

entity order_items {
  * **id** : uuid <<PK>>
  --
  * **order_id** : uuid <<FK>>
  * **product_id** : uuid <<FK>>
  * quantity : integer
  * price : numeric(12,2)
  ..
  check (quantity > 0)
  check (price >= 0)
}

users ||-d-o{ orders
places ||-r-o| place_ratings
places ||-d-o{ products
places ||--o{ orders
orders ||-d-o{ order_tracking
orders ||-d-o| order_ratings
users ||--o{ order_ratings
places ||--o{ order_ratings
orders ||--|{ order_items
products ||-d-o{ order_items

@enduml

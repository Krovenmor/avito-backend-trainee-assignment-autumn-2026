@startuml c4-containers
!include <C4/C4_Container>

title C4 Level 2 — контейнеры

Person(user, "Пользователь", "Ищет еду, оформляет заказы и следит за их статусом")

System_Boundary(platform, "Авито.Кухня") {
    Container(kitchen, "kitchen", "Go 1.26, fx", "Модульный монолит из доменов orders и places. B2C и B2B API, SSE, вебхук к заведению, фоновый проход по заказам")
    ContainerDb(pg, "PostgreSQL", "PostgreSQL 17", "Всё состояние платформы: заведения, меню с остатками, заказы, оценки. Резерв остатка коммитится вместе с заказом")
    ContainerDb(redis, "Redis", "Redis 7", "Поток событий заказа для SSE и ключи идемпотентности")
}

System_Boundary(partner, "Тестовое заведение") {
    Container(testapi, "testapi", "Go 1.26, fx", "Эмулятор заведения: регистрируется сам, отвечает на вебхук, продаёт мимо платформы, сообщает о готовке и доставке")
}

Rel(user, kitchen, "Ищет еду, оформляет, отменяет и оценивает заказы", "HTTPS/JSON")
Rel_R(kitchen, user, "Присылает статусы заказа\nв открытое клиентом соединение", "SSE")

Rel(kitchen, pg, "Читает и пишет", "pgx")
Rel(kitchen, redis, "Публикует и читает события,\nдержит ключи идемпотентности", "go-redis")

Rel(testapi, kitchen, "Регистрируется, заливает меню, пополняет остаток,\nсообщает о готовке и доставке", "HTTPS/JSON, X-API-Key")
Rel_L(kitchen, testapi, "Спрашивает решение по заказу,\nповторяет с нарастающей паузой", "HTTPS, вебхук")

SHOW_LEGEND()
@enduml
